usuarios = []
produtos = []
historico_vendas = []


def cadastrar_usuario():

    usuario = input("Crie um usuário: ")
    senha = input("Crie uma senha: ")

    for u in usuarios:
        if u["usuario"] == usuario:
            print("Usuário já existe.")
            return

    novo_usuario = {
        "usuario": usuario,
        "senha": senha
    }

    usuarios.append(novo_usuario)

    print("Usuário cadastrado com sucesso.")


def login():

    tentativas = 0

    while tentativas < 3:

        usuario_login = input("Usuário: ")
        senha_login = input("Senha: ")

        for u in usuarios:

            if u["usuario"] == usuario_login and u["senha"] == senha_login:
                print("\nLogin realizado com sucesso!\n")
                return True

        tentativas += 1

        print("Usuário ou senha incorretos.")
        print("Tentativas restantes:", 3 - tentativas)

    print("Sistema bloqueado.")
    return False


def cadastrar_produto():

    codigo = input("Código do produto: ")

    for produto in produtos:

        if produto["codigo"] == codigo:
            print("Código já existe.")
            return

    nome = input("Nome do produto: ")

    preco = float(input("Preço: "))

    if preco < 0:
        print("Preço inválido.")
        return

    estoque = int(input("Quantidade em estoque: "))

    if estoque < 0:
        print("Estoque inválido.")
        return

    produto = {
        "codigo": codigo,
        "nome": nome,
        "preco": preco,
        "estoque": estoque,
        "vendidos": 0
    }

    produtos.append(produto)

    print("Produto cadastrado com sucesso.")


def listar_produtos():

    if len(produtos) == 0:
        print("Nenhum produto cadastrado.")

    else:

        print("\n Produtos: ")

        for produto in produtos:

            print("Código:", produto["codigo"])
            print("Nome:", produto["nome"])
            print("Preço: R$", produto["preco"])
            print("Estoque:", produto["estoque"])


def realizar_venda():

    codigo = input("Código do produto: ")

    for produto in produtos:

        if produto["codigo"] == codigo:

            quantidade = int(input("Quantidade: "))

            if quantidade <= 0:
                print("Quantidade inválida.")
                return

            if quantidade > produto["estoque"]:
                print("Estoque insuficiente.")
                return

            total = quantidade * produto["preco"]

            produto["estoque"] -= quantidade
            produto["vendidos"] += quantidade

            venda = {
                "nome": produto["nome"],
                "quantidade": quantidade,
                "total": total
            }

            historico_vendas.append(venda)

            print("\n Cupom fiscal")
            print("Produto:", produto["nome"])
            print("Quantidade:", quantidade)
            print("Total: R$", total)

            return

    print("Produto não encontrado.")


def repor_estoque():

    codigo = input("Código do produto: ")

    for produto in produtos:

        if produto["codigo"] == codigo:

            quantidade = int(input("Quantidade para repor: "))

            if quantidade < 0:
                print("Quantidade inválida.")
                return

            produto["estoque"] += quantidade

            print("Estoque atualizado.")
            return

    print("Produto não encontrado.")


def relatorio():

    if len(produtos) == 0:
        print("Nenhum produto cadastrado.")
        return

    produto_mais_caro = produtos[0]
    maior_estoque = produtos[0]

    valor_total_estoque = 0
    quantidade_total = 0

    for produto in produtos:

        if produto["preco"] > produto_mais_caro["preco"]:
            produto_mais_caro = produto

        if produto["estoque"] > maior_estoque["estoque"]:
            maior_estoque = produto

        valor_total_estoque += produto["preco"] * produto["estoque"]
        quantidade_total += produto["estoque"]

    print("\n Relatório: ")
    print("Produto mais caro:", produto_mais_caro["nome"])
    print("Produto com maior estoque:", maior_estoque["nome"])
    print("Valor total do estoque: R$", valor_total_estoque)
    print("Quantidade total de produtos:", quantidade_total)


def pesquisar_produto():

    nome = input("Digite o nome do produto: ")

    encontrado = False

    for produto in produtos:

        if nome.lower() in produto["nome"].lower():

            print("\nProduto encontrado:")
            print("Código:", produto["codigo"])
            print("Nome:", produto["nome"])
            print("Preço: R$", produto["preco"])
            print("Estoque:", produto["estoque"])

            encontrado = True

    if not encontrado:
        print("Produto não encontrado.")


def historico():

    if len(historico_vendas) == 0:
        print("Nenhuma venda realizada.")

    else:

        print("\n Histórico: ")

        for venda in historico_vendas:

            print("Produto:", venda["nome"])
            print("Quantidade:", venda["quantidade"])
            print("Total: R$", venda["total"])


print("Cadastro de usuário")
cadastrar_usuario()

print("\n Login: ")

if login():

    while True:

        print("\n SUPERMERCADO ")
        print("1 - Cadastrar produto")
        print("2 - Listar produtos")
        print("3 - Realizar venda")
        print("4 - Repor estoque")
        print("5 - Relatório")
        print("6 - Pesquisar produto")
        print("7 - Histórico de vendas")
        print("8 - Sair")

        opcao = input("Escolha uma opção: ")

        if opcao == "1":
            cadastrar_produto()

        elif opcao == "2":
            listar_produtos()

        elif opcao == "3":
            realizar_venda()

        elif opcao == "4":
            repor_estoque()

        elif opcao == "5":
            relatorio()

        elif opcao == "6":
            pesquisar_produto()

        elif opcao == "7":
            historico()

        elif opcao == "8":
            print("Sistema encerrado.")
            break

        else:
            print("Opção inválida.")
